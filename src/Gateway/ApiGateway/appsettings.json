{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/Auth/{**resto}" }
      },

      "pacientes": {
        "ClusterId": "directory",
        "Match": { "Path": "/api/Pacientes/{**resto}" }
      },
      "medicos": {
        "ClusterId": "directory",
        "Match": { "Path": "/api/Medicos/{**resto}" }
      },
      "especialidades": {
        "ClusterId": "directory",
        "Match": { "Path": "/api/Especialidades/{**resto}" }
      },

      "citas": {
        "ClusterId": "agenda",
        "Match": { "Path": "/api/Citas/{**resto}" }
      },
      "horarios": {
        "ClusterId": "agenda",
        "Match": { "Path": "/api/Horarios/{**resto}" }
      },

      "atenciones": {
        "ClusterId": "clinical",
        "Match": { "Path": "/api/Atenciones/{**resto}" }
      },
      "expedientes": {
        "ClusterId": "clinical",
        "Match": { "Path": "/api/expedientes/{**resto}" }
      },
      "catalogos": {
        "ClusterId": "clinical",
        "Match": { "Path": "/api/catalogos/{**resto}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5156/" } } },
      "directory": { "Destinations": { "d1": { "Address": "http://localhost:5185/" } } },
      "agenda": { "Destinations": { "d1": { "Address": "http://localhost:5400/" } } },
      "clinical": { "Destinations": { "d1": { "Address": "http://localhost:5500/" } } }
    }
  }
}