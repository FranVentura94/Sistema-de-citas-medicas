{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/Auth/{**resto}"
        }
      },
      "usuarios": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/Usuarios/{**resto}"
        }
      },
      "pacientes": {
        "ClusterId": "directory",
        "Match": {
          "Path": "/api/Pacientes/{**resto}"
        }
      },
      "medicos": {
        "ClusterId": "directory",
        "Match": {
          "Path": "/api/Medicos/{**resto}"
        }
      },
      "especialidades": {
        "ClusterId": "directory",
        "Match": {
          "Path": "/api/Especialidades/{**resto}"
        }
      },
      "empleados": {
        "ClusterId": "directory",
        "Match": {
          "Path": "/api/Empleados/{**resto}"
        }
      },
      "citas": {
        "ClusterId": "agenda",
        "Match": {
          "Path": "/api/Citas/{**resto}"
        }
      },
      "horarios": {
        "ClusterId": "agenda",
        "Match": {
          "Path": "/api/Horarios/{**resto}"
        }
      },
      "accesos": {
        "ClusterId": "agenda",
        "Match": {
          "Path": "/api/Accesos/{**resto}"
        }
      },
      "atenciones": {
        "ClusterId": "clinical",
        "Match": {
          "Path": "/api/Atenciones/{**resto}"
        }
      },
      "expedientes": {
        "ClusterId": "clinical",
        "Match": {
          "Path": "/api/expedientes/{**resto}"
        }
      },
      "catalogos": {
        "ClusterId": "clinical",
        "Match": {
          "Path": "/api/catalogos/{**resto}"
        }
      },
      "triajes": {
        "ClusterId": "clinical",
        "Match": {
          "Path": "/api/Triajes/{**resto}"
        }
      },
      "auditoria-identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auditoria/identity/{**resto}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Auditoria/{**resto}"
          }
        ]
      },
      "auditoria-directory": {
        "ClusterId": "directory",
        "Match": {
          "Path": "/api/auditoria/directory/{**resto}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Auditoria/{**resto}"
          }
        ]
      },
      "auditoria-agenda": {
        "ClusterId": "agenda",
        "Match": {
          "Path": "/api/auditoria/agenda/{**resto}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Auditoria/{**resto}"
          }
        ]
      },
      "auditoria-clinical": {
        "ClusterId": "clinical",
        "Match": {
          "Path": "/api/auditoria/clinical/{**resto}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Auditoria/{**resto}"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5156/"
          }
        }
      },
      "directory": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5185/"
          }
        }
      },
      "agenda": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5400/"
          }
        }
      },
      "clinical": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5500/"
          }
        }
      }
    }
  }
}