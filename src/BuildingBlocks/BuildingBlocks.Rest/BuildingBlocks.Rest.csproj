<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageId>BuildingBlocks.Rest</PackageId>
		<Version>1.0.0</Version>
		<Authors>Francisco Ventura</Authors>
		<Description>Cliente HTTP fluido para la comunicación entre microservicios .NET.</Description>
	</PropertyGroup>

	<ItemGroup>
