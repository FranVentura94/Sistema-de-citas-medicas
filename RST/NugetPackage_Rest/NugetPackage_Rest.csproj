<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Metadatos del paquete NuGet -->
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>NugetPackageRest</PackageId>
		<Version>2.2.0</Version>
		<Authors>Autor del curso</Authors>
		<Description>Cliente HTTP fluido para la comunicación entre microservicios .NET.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Serilog" Version="4.3.0" />
	</ItemGroup>

	<!-- Permite que el proyecto de pruebas vea las clases internal (builders, executor) -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>NugetPackage_Rest.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>